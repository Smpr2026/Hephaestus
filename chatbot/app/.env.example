# Copy to .env and fill in, or just export these in your shell.
# Everything runs without them — you only need the key to use Claude
# instead of the built-in matcher.

# ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (defaults to claude-opus-5).
# claude-haiku-4-5 is the cheap, fast option for a storefront widget.
# SMPR_MODEL=claude-haiku-4-5

# PORT=3000

# ---- Live prices from the FixDesk quoting module ----
# Leave unset and the bot uses the price table in knowledge-base.json.
# Set these and a price question goes to FixDesk first, so the techs' numbers
# are the ones customers hear. If FixDesk is slow or down, the bot quietly
# falls back to the knowledge base - a quoting outage never breaks the chat.
# FIXDESK_URL=https://fixdesk.pro
# FIXDESK_TOKEN=
# FIXDESK_QUOTE_PATH=/api/quotes
